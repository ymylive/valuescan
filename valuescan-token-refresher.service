[Unit]
Description=ValueScan Token Auto Refresher (Chromium UI)
Documentation=https://github.com/ymylive/valuescan
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/valuescan/signal_monitor
# Use Chromium UI automation (click/type) to refresh tokens
ExecStart=/usr/bin/python3 /root/valuescan/signal_monitor/token_refresher.py --interval 0.8
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal

# 环境变量
Environment=DISPLAY=:99
Environment=PYTHONUNBUFFERED=1
Environment=VALUESCAN_LOGIN_METHOD=auto
Environment=VALUESCAN_DISABLE_HTTP_LOGIN=0
Environment=VALUESCAN_BROWSER_STARTUP_TIMEOUT=60
EnvironmentFile=-/root/valuescan/config/valuescan.env

[Install]
WantedBy=multi-user.target
