# ValuScan 后端 Dockerfile
FROM python:3.11-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY signal_monitor/requirements.txt /app/signal_monitor/
COPY api/requirements.txt /app/api/

# 安装 Python 依赖
RUN pip install --no-cache-dir -r /app/signal_monitor/requirements.txt && \
    pip install --no-cache-dir -r /app/api/requirements.txt && \
    pip install --no-cache-dir flask-limiter

# 复制项目文件
COPY signal_monitor/ /app/signal_monitor/
COPY api/ /app/api/
COPY auth/ /app/auth/
COPY config/ /app/config/
COPY crypto/ /app/crypto/

# 设置环境变量
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# 暴露端口
EXPOSE 8080

# 启动命令
CMD ["python3", "/app/api/server.py"]
