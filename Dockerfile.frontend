# ValuScan 前端 Dockerfile - 仅构建静态文件
FROM node:20-alpine AS builder

WORKDIR /app

# 复制 package 文件
COPY web/package*.json ./

# 安装依赖
RUN npm install

# 复制源代码
COPY web/ ./

# 构建静态文件
RUN npm run build

# 使用 nginx 服务静态文件
FROM nginx:alpine

# 复制构建产物到 nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制 nginx 配置（如果需要自定义）
# COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
