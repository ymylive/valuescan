# NOFX Environment Variables Template
# Copy this file to .env and modify the values as needed

# ===========================================
# Server Configuration
# ===========================================

# Backend API port (maps to container port 5000)
NOFX_BACKEND_PORT=8080

# Frontend web port (maps to container port 80)
NOFX_FRONTEND_PORT=3000

# Timezone
NOFX_TIMEZONE=Asia/Shanghai

# ===========================================
# Logging
# ===========================================

# Log file inside the container
NOFX_LOG_FILE=data/signal_monitor.log
NOFX_API_LOG_FILE=data/api.log
NOFX_LOG_LEVEL=INFO
NOFX_LOG_TO_FILE=1

# ===========================================
# Realtime Monitors
# ===========================================

# Enable realtime market monitors (US market, anomaly, macro)
NOFX_REALTIME_MARKET_ENABLED=true

# Enable AI key levels generation
NOFX_ENABLE_AI_KEY_LEVELS=true
NOFX_AI_LEVELS_ENABLED=1
NOFX_AI_LEVELS_MODEL=valuescan

# Finnhub API key (optional, for US market quotes)
# NOFX_FINNHUB_API_KEY=

# ===========================================
# Telegram Notifications (optional)
# ===========================================

NOFX_ENABLE_TELEGRAM=1
NOFX_TELEGRAM_BOT_TOKEN=your-bot-token
NOFX_TELEGRAM_CHAT_ID=your-chat-id
NOFX_SEND_TG_IN_MODE_1=1

# ===========================================
# Authentication (Required)
# ===========================================

# Admin credentials (REQUIRED - no defaults provided)
# Set strong credentials before deployment
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Alternative environment variable names (for compatibility)
NOFX_ADMIN_USERNAME=
NOFX_ADMIN_PASSWORD=

# JWT signing secret (any random string, at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=

# ===========================================
# Encryption Keys (Required)
# ===========================================

# AES-256 data encryption key (Base64 encoded, 32 bytes)
# Used for encrypting sensitive data in database (API keys, secrets)
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# RSA private key for client-server encryption (PEM format)
# Used for end-to-end encryption of sensitive data from browser
# Generate with: openssl genrsa 2048
# Note: Replace newlines with \n for single-line format
RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----

# ===========================================
# Security Options
# ===========================================

# Transport encryption for API keys (default: false)
# When enabled, browser uses Web Crypto API to encrypt API keys before sending
# Requires HTTPS or localhost to work
# Set to true for enhanced security (HTTPS required)
# Set to false for easier deployment (HTTP/IP access allowed)
TRANSPORT_ENCRYPTION=false

# ===========================================
# Optional: External Services
# ===========================================

# Binance proxy (optional, for restricted networks)
# BINANCE_SOCKS5_PROXY=socks5://host.docker.internal:1080
# BINANCE_HTTP_PROXY=http://proxy.example.com:8080
# BINANCE_PROXY_URL=socks5://user:pass@proxy.example.com:1080
# BINANCE_DOCKER_PROXY_HOST=host.docker.internal

# NOFX data source (optional)
# NOFX_API_BASE=
# NOFX_API_TOKEN=

# ===========================================
# Macro / Fundamentals (optional)
# ===========================================

# FRED API key (optional; CSV fallback is used if omitted)
# FRED_API_KEY=
# NOFX_FRED_SERIES=PAYEMS,CPIAUCSL,UNRATE,FEDFUNDS
# NOFX_FRED_RELEASE_IDS=10,46,50,53,54,101

# ForexFactory calendar (weekly)
# NOFX_FF_CALENDAR_ENABLED=true
# NOFX_FF_CALENDAR_TTL_SEC=1800
# NOFX_FF_CALENDAR_CACHE_MAX_AGE_SEC=86400
# NOFX_FF_CALENDAR_TZ=America/New_York

# TradingEconomics calendar (requires API key)
# NOFX_TE_CALENDAR_ENABLED=true
# TRADING_ECONOMICS_API_KEY=
# NOFX_TE_API_KEY=
# NOFX_TE_CALENDAR_TTL_SEC=900

# GDELT news (macro/event headlines)
# NOFX_GDELT_ENABLED=true
# NOFX_GDELT_QUERY=(policy OR regulation OR rate decision OR inflation OR geopolitics)
# NOFX_GDELT_TIMESPAN=1d

# 金十数据 Telegram 快讯（消息面）
# NOFX_JIN10_TG_ENABLED=true
# NOFX_JIN10_TG_CHANNEL=jin10data
# NOFX_JIN10_TG_TTL_SEC=300
# NOFX_JIN10_TG_MAX_PAGES=8

# Chart image validation (avoid red/error images)
# NOFX_CHART_MIN_KB=25

# ===========================================
# TradingView chart-img (for async chart images)
# ===========================================
# NOFX_CHART_IMG_API_KEY=
# NOFX_CHART_IMG_LAYOUT_ID=
# NOFX_CHART_IMG_WIDTH=800
# NOFX_CHART_IMG_HEIGHT=600
# NOFX_CHART_IMG_TIMEOUT=90

# ===========================================
# Metals OHLC data providers
# ===========================================
# NOFX_METALS_KLINE_PROVIDERS=binance
# NOFX_OANDA_API_KEY=
# NOFX_OANDA_ENV=practice
# NOFX_TWELVEDATA_API_KEY=
# NOFX_METALS_KLINES_TTL=10
# NOFX_METALS_CHART_INTERVAL=15m
# NOFX_METALS_AI_INTERVAL=15m
# NOFX_METALS_ALLOW_YAHOO_FALLBACK=0
