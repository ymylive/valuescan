{
  "enabled": true,
  "api_key": "<SET_IN_ENV>",
  "api_url": "https://chat.cornna.xyz/gemini/v1",
  "api_protocol": "auto",
  "model": "gemini-3-flash-search",
  "fallbacks": [
    {
      "api_key": "<SET_IN_ENV>",
      "api_url": "https://api-inference.modelscope.cn/v1",
      "api_protocol": "compatible",
      "model": "ZhipuAI/GLM-5"
    },
    {
      "api_key": "<SET_IN_ENV>",
      "api_url": "https://openrouter.ai/api/v1",
      "api_protocol": "compatible",
      "model": "tngtech/deepseek-r1t2-chimera:free"
    }
  ],
  "mcp_search": {
    "enabled": true,
    "max_parallel_sources": 2,
    "max_results": 8,
    "timeout_sec": 30,
    "cache_ttl_sec": 900,
    "max_prompt_chars": 3200,
    "query_template": "{symbol} {title} latest market news macro policy risk funding sentiment onchain derivatives",
    "sources": [
      {
        "name": "tavily",
        "enabled": true,
        "command": "npx",
        "args": "-y tavily-mcp@latest",
        "tool_name": "tavily-search",
        "jsonrpc_mode": "line",
        "timeout_sec": 60,
        "max_results": 8,
        "arguments": {
          "query": "{query}",
          "max_results": 8,
          "search_depth": "advanced"
        },
        "env": {
          "TAVILY_API_KEY": "${NOFX_TAVILY_API_KEY}"
        }
      },
      {
        "name": "jin10",
        "enabled": true,
        "command": "python",
        "args": "-u scripts/jin10_search_mcp_server.py",
        "tool_name": "jin10_news_search",
        "timeout_sec": 12,
        "max_results": 6
      }
    ]
  },
  "interval_hours": 1.0,
  "lookback_hours": 24
}
